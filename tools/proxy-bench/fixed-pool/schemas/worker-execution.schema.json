{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "worker-execution v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "worker_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "process_started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "process_ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "termination_reason": {
      "enum": [
        "completed",
        "failed",
        "interrupted",
        "start_failed"
      ]
    },
    "summary_present": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "worker_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "stage",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "worker_id",
    "process_started_at",
    "process_ended_at",
    "exit_code",
    "termination_reason",
    "summary_present",
    "errors"
  ]
}
