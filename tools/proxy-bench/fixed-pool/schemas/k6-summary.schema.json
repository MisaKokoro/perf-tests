{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "k6-summary v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "worker_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "k6_version": {
      "const": "2.3.0"
    },
    "native_summary": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "worker_id",
    "manifest_id",
    "plan_id",
    "k6_version",
    "native_summary"
  ]
}
