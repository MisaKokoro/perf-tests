{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "worker-spec v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "worker_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "objects_file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "region_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "range_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "regions_per_object": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "proxy": {
      "type": "string",
      "minLength": 1
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Accept-Encoding": {
          "const": "identity"
        },
        "X-Dragonfly-Enable-Task-Id-Based-Blob-Digest": {
          "const": "false"
        },
        "X-Dragonfly-Prefetch": {
          "const": "false"
        },
        "X-Dragonfly-Use-P2p": {
          "const": "true"
        }
      },
      "required": [
        "Accept-Encoding",
        "X-Dragonfly-Enable-Task-Id-Based-Blob-Digest",
        "X-Dragonfly-Prefetch",
        "X-Dragonfly-Use-P2p"
      ]
    },
    "rate": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "graceful_stop_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pre_allocated_vus": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "max_vus": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "worker_id",
    "plan_id",
    "manifest_id",
    "objects_file",
    "shard",
    "region_count",
    "range_bytes",
    "regions_per_object",
    "proxy",
    "headers",
    "rate",
    "duration_ms",
    "timeout_ms",
    "graceful_stop_ms",
    "pre_allocated_vus",
    "max_vus"
  ]
}
