{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dataset-result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "generated_objects": {
      "type": "integer",
      "minimum": 0
    },
    "generated_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "stage",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "manifest",
    "generated_objects",
    "generated_bytes",
    "elapsed_ms",
    "errors"
  ]
}
