{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan-result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "region_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "worker_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "reused": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "estimates": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "file_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "memory_bytes",
        "file_bytes"
      ]
    },
    "actual_file_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "stage",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "manifest_sha256",
    "plan",
    "region_count",
    "worker_count",
    "reused",
    "estimates",
    "actual_file_bytes",
    "elapsed_ms",
    "errors"
  ]
}
