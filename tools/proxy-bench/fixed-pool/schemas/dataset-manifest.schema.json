{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dataset-manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "aes256-counter-v1"
        },
        "seed": {
          "const": "nydus-range-content-v1"
        },
        "block_bytes": {
          "const": 16
        }
      },
      "required": [
        "version",
        "seed",
        "block_bytes"
      ]
    },
    "object_size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "object_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^http://"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^objects/sha256/[0-9a-f]{64}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^http://"
          }
        },
        "required": [
          "object_id",
          "size_bytes",
          "sha256",
          "relative_path",
          "url"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "generator",
    "object_size_bytes",
    "object_count",
    "base_url",
    "objects"
  ]
}
