# Copy to source.env and fill the required deployment-specific values.
SOURCE_NAME=fixed-pool-source
NAMESPACE=benchmark
DNS_DOMAIN=cluster.local
# Empty derives http://SOURCE_NAME.NAMESPACE.svc.DNS_DOMAIN during rendering.
# An external Seed needs an explicitly provisioned, reachable stable endpoint.
BASE_URL=
B=4194304
N=4
GENERATION_WORKERS=1
PVC_NAME=fixed-pool-source
PVC_STORAGE_CLASS=
PVC_CAPACITY=1Gi
# Use immutable repository@sha256:... image references, not mutable tags.
TOOLS_IMAGE=
FILE_SERVER_IMAGE=
SOURCE_NODE=
DATA_UID=1000
DATA_GID=1000
FS_GROUP=1000
DATA_CPU_REQUEST=1
DATA_CPU_LIMIT=2
DATA_MEMORY_REQUEST=128Mi
DATA_MEMORY_LIMIT=512Mi
SERVER_CPU_REQUEST=100m
SERVER_CPU_LIMIT=1
SERVER_MEMORY_REQUEST=64Mi
SERVER_MEMORY_LIMIT=256Mi
