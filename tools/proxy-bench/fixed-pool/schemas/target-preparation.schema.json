{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "target-preparation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "preparation_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "piece_strategy": {
      "const": "auto"
    },
    "target": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "proxy": {
              "type": "string",
              "pattern": "^http://"
            },
            "expected_server_ip": {
              "type": "string",
              "minLength": 1
            },
            "instance_ref": {
              "type": "string",
              "minLength": 1
            },
            "client_version": {
              "const": "v1.5.7"
            }
          },
          "required": [
            "ref",
            "proxy",
            "expected_server_ip",
            "instance_ref",
            "client_version"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "client_version": {
      "anyOf": [
        {
          "const": "v1.5.7"
        },
        {
          "type": "null"
        }
      ]
    },
    "prepare": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "request_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854
            },
            "ready_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854
            }
          },
          "required": [
            "concurrency",
            "request_timeout_ms",
            "ready_timeout_ms"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "const": "http-full-body-and-finished-v1"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ready",
        "failed",
        "unverified"
      ]
    },
    "object_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_file": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "object_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "code",
          "stage",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "preparation_id",
    "manifest_sha256",
    "identity_sha256",
    "piece_strategy",
    "target",
    "client_version",
    "prepare",
    "method",
    "started_at",
    "ended_at",
    "status",
    "object_count",
    "evidence_file",
    "errors"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "identity_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "proxy": {
                "type": "string",
                "pattern": "^http://"
              },
              "expected_server_ip": {
                "type": "string",
                "minLength": 1
              },
              "instance_ref": {
                "type": "string",
                "minLength": 1
              },
              "client_version": {
                "const": "v1.5.7"
              }
            },
            "required": [
              "ref",
              "proxy",
              "expected_server_ip",
              "instance_ref",
              "client_version"
            ]
          },
          "client_version": {
            "const": "v1.5.7"
          },
          "prepare": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "concurrency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "request_timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854
              },
              "ready_timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854
              }
            },
            "required": [
              "concurrency",
              "request_timeout_ms",
              "ready_timeout_ms"
            ]
          },
          "object_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "evidence_file": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "errors": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
