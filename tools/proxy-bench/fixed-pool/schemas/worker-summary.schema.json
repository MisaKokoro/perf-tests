{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "worker-summary v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "result_complete": {
      "type": "boolean"
    },
    "execution_state": {
      "enum": [
        "completed",
        "failed",
        "interrupted",
        "unknown"
      ]
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "worker_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ACTUAL_QPS": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "REQUESTS_TOTAL": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "DROPPED_ITERATIONS": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "SUCCESS_PCT": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "P99_MS": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "P50_MS": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "P95_MS": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "MEAN_MS": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "MAX_MS": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "TOOL_DURATION_S": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "DATA_RECEIVED_BYTES": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "ACTUAL_QPS",
              "REQUESTS_TOTAL",
              "DROPPED_ITERATIONS",
              "SUCCESS_PCT",
              "P99_MS",
              "P50_MS",
              "P95_MS",
              "MEAN_MS",
              "MAX_MS",
              "TOOL_DURATION_S",
              "DATA_RECEIVED_BYTES"
            ]
          },
          "plan_consumed": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "count"
            ]
          },
          "iterations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "count"
            ]
          },
          "http_reqs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "count"
            ]
          },
          "successful_samples": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "failed_samples": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "coverage": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "unique_regions": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "logical_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "unique_regions",
                  "logical_bytes",
                  "ratio"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "worker_id",
          "metrics",
          "plan_consumed",
          "iterations",
          "http_reqs",
          "successful_samples",
          "failed_samples",
          "coverage"
        ]
      }
    },
    "aggregate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ACTUAL_QPS": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "REQUESTS_TOTAL": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "DROPPED_ITERATIONS": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "SUCCESS_PCT": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "P99_MS": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "P50_MS": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "P95_MS": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "MEAN_MS": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "MAX_MS": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "TOOL_DURATION_S": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "DATA_RECEIVED_BYTES": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "ACTUAL_QPS",
            "REQUESTS_TOTAL",
            "DROPPED_ITERATIONS",
            "SUCCESS_PCT",
            "P99_MS",
            "P50_MS",
            "P95_MS",
            "MEAN_MS",
            "MAX_MS",
            "TOOL_DURATION_S",
            "DATA_RECEIVED_BYTES"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unique_regions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "logical_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "unique_regions",
            "logical_bytes",
            "ratio"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "worker_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "stage",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "references",
    "result_complete",
    "execution_state",
    "workers",
    "aggregate",
    "coverage",
    "errors"
  ]
