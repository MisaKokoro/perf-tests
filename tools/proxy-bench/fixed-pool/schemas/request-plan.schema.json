{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "request-plan v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "range_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "regions_per_object": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "region_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "algorithm": {
      "const": "fisher-yates-aes32-v1"
    },
    "seed": {
      "const": "nydus-range-order-v1"
    },
    "worker_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "objects_file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "object-urls.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "worker_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967294
          },
          "region_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "path": {
            "type": "string",
            "pattern": "^shards/[0-9]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "worker_id",
          "region_count",
          "path",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "manifest_sha256",
    "range_bytes",
    "regions_per_object",
    "region_count",
    "algorithm",
    "seed",
    "worker_count",
    "objects_file",
    "shards"
  ]
}
