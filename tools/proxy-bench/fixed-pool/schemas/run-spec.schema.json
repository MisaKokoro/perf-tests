{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run-spec v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "target_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "target_preparation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "identity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "proxy": {
          "type": "string",
          "pattern": "^http://"
        },
        "expected_server_ip": {
          "type": "string",
          "minLength": 1
        },
        "instance_ref": {
          "type": "string",
          "minLength": 1
        },
        "client_version": {
          "const": "v1.5.7"
        }
      },
      "required": [
        "ref",
        "proxy",
        "expected_server_ip",
        "instance_ref",
        "client_version"
      ]
    },
    "total_rate": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "worker_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "graceful_stop_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "worker_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "region_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "rate": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "worker_id",
          "region_count",
          "rate"
        ]
      }
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "manifest",
    "target_config",
    "target_preparation",
    "plan",
    "identity_sha256",
    "target",
    "total_rate",
    "worker_count",
    "duration_ms",
    "timeout_ms",
    "graceful_stop_ms",
    "workers",
    "tool_versions"
  ]
}
